    "marian.s"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.kismetcalc.client.KismetCalcClient"
    ]
  },
  "mixins": [
    "kismetcalc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2"
  }
}
